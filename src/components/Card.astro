---
import i from '../../public/My-proyecto.png'
import Image from 'astro/components/Image.astro';
---


<div class="w-[300px] h-auto m-auto">
    <div class="mb-4">
        <Image src={i} alt="img" class="rounded-xl"  />
        <span class="text-black"> aca van los logos de las tecnologias</span>
    </div>
